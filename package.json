{
  "name": "pdf-highligher",
  "version": "2.0.0",
  "description": "pdf批注 - Vue 3 + TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@embedpdf/engine": "^3.2.0",
    "@embedpdf/vue": "^3.2.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "sass": "^1.108.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git@repo.gokuai.cn:web/pdf-highligher.git"
  },
  "license": "MIT",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
